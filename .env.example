# MongoDB Connection String (e.g. mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/dbname)
MONGODB_URI=mongodb://localhost:27017/stock-management

# NextAuth Configuration
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET=fallback_secret_must_change_in_production
NEXTAUTH_URL=http://localhost:3000

# Cloudflare R2 / S3 Configuration
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# e.g., https://pub-xxxxxx.r2.dev or custom domain where objects are publicly readable
R2_PUBLIC_BASE_URL=
# hostname of public base URL, e.g. pub-xxxxxx.r2.dev or your custom domain, used for deleting files
R2_PUBLIC_HOSTNAME=

# Admin User Seed Configuration (run npm run create-admin to seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=AdminSecurePassword123!
